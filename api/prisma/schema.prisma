generator client {
    provider     = "prisma-client"
    output       = "../src/generated/prisma"
    moduleFormat = "cjs"
}

datasource db {
    provider = "postgresql"
}

model Product {
    id              String          @id
    name            String
    description     String
    category        String
    price           Int
    stock           Int
    isPublished     Boolean         @default(true)
    productCategory ProductCategory @relation(fields: [category], references: [id])
    cartItems       CartItem[]
    orderItems      OrderItem[]

    @@index([category])
}

model ProductCategory {
    id       String    @id
    name     String
    products Product[]
}

model Customer {
    id           String     @id @default(cuid())
    email        String     @unique
    lastName     String
    firstName    String?
    passwordHash String
    cartItems    CartItem[]
    orders       Order[]
}

model Member {
    id           String  @id @default(cuid())
    email        String  @unique
    lastName     String
    firstName    String?
    passwordHash String
}

model CartItem {
    customerId String
    productId  String
    quantity   Int
    customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
    product    Product  @relation(fields: [productId], references: [id])

    @@id([customerId, productId])
    @@index([productId])
}

enum OrderStatus {
    PLACED
    SHIPPED
}

model Order {
    id              String                @id @default(cuid())
    customerId      String
    total           Int
    shippingAddress OrderShippingAddress?
    status          OrderStatus           @default(PLACED)
    createdAt       DateTime              @default(now())
    customer        Customer              @relation(fields: [customerId], references: [id])
    items           OrderItem[]

    @@index([customerId, createdAt])
    @@index([createdAt])
}

model OrderShippingAddress {
    orderId    String @id
    name       String
    postalCode String
    prefecture String
    city       String
    line1      String
    line2      String @default("")
    phone      String
    order      Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model OrderItem {
    id        String  @id @default(cuid())
    orderId   String
    productId String
    name      String
    unitPrice Int
    quantity  Int
    order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
    product   Product @relation(fields: [productId], references: [id])

    @@index([orderId])
    @@index([productId])
}
