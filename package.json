{
  "name": "thread",
  "private": true,
  "type": "module",
  "workspaces": [
    "web",
    "admin",
    "api",
    "packages/shared"
  ],
  "scripts": {
    "dev": "concurrently -k -n EC,\u7ba1\u7406,API \"npm run dev:store\" \"npm run dev:admin\" \"npm run dev:api\"",
    "db:generate": "npm run db:generate -w api",
    "db:migrate": "npm run db:migrate -w api",
    "db:seed": "npm run db:seed -w api",
    "db:seed:large": "npm run db:seed:large -w api",
    "benchmark:sales": "npm run benchmark:sales -w api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "lint": "eslint web/src web/vite.config.ts admin/src admin/vite.config.ts packages/shared/src api/src api/prisma api/prisma.config.ts grading",
    "test": "npm run test -w web && npm run test -w api",
    "grade": "node grading/grade.mjs",
    "dev:store": "npm run dev -w web",
    "dev:admin": "npm run dev -w admin",
    "dev:api": "npm run dev -w api"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "concurrently": "^9.2.0",
    "eslint": "^9.39.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.56.0"
  },
  "overrides": {
    "@prisma/config": {
      "effect": "3.22.5"
    }
  }
}
