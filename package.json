{
  "name": "thread",
  "private": true,
  "type": "module",
  "workspaces": [
    "web",
    "api"
  ],
  "scripts": {
    "dev": "concurrently -k -n EC,API \"npm run dev -w web\" \"npm run dev -w api\"",
    "db:generate": "npm run db:generate -w api",
    "db:migrate": "npm run db:migrate -w api",
    "db:seed": "npm run db:seed -w api",
    "typecheck": "npm run typecheck --workspaces",
    "build": "npm run build --workspaces",
    "lint": "eslint web/src web/vite.config.ts api/src api/prisma api/prisma.config.ts grading",
    "test": "npm run test -w web && npm run test -w api",
    "grade": "node grading/grade.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "concurrently": "^9.2.0",
    "eslint": "^9.39.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.56.0"
  },
  "overrides": {
    "@prisma/config": {
      "effect": "3.22.5"
    }
  }
}
